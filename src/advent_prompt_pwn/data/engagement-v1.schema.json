{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:advent-prompt-pwn:schema:engagement:v1",
  "title": "advent-prompt-pwn engagement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "engagement", "corpus", "target", "scope"],
  "properties": {
    "version": {"const": 1},
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "authorization_reference"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"},
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "authorization_reference": {"type": "string", "minLength": 1}
      }
    },
    "corpus": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["fake", "http-json", "ollama", "openai-compatible"]},
        "name": {"type": "string"},
        "model": {"type": "string"},
        "base_url": {"type": "string"},
        "endpoint": {"type": "string"},
        "api_key_env": {"type": "string"},
        "fake_response": {"type": "string"},
        "headers_env": {"type": "object", "additionalProperties": {"type": "string"}},
        "request_mode": {"enum": ["messages", "prompt"]},
        "request_field": {"type": "string"},
        "response_path": {"type": "string"},
        "tool_calls_path": {"type": "string"},
        "extra_body_file": {"type": "string"},
        "max_response_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_requests", "requests_per_minute", "max_concurrency"],
      "properties": {
        "mode": {"enum": ["local", "authorized_remote"]},
        "allowed_hosts": {"type": "array", "items": {"type": "string"}},
        "allowed_ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "max_requests": {"type": "integer", "minimum": 1},
        "requests_per_minute": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "allow_insecure_http": {"type": "boolean"}
        ,"allowed_query_parameters": {"type": "array", "items": {"type": "string"}}
        ,"allow_unpinned_dns": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategies": {"type": "array", "items": {"type": "string"}},
        "seed": {"type": "integer"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "retry_backoff_seconds": {"type": "number", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "trials_per_variant": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_variants_per_case": {"type": "integer", "minimum": 1},
        "checkpoint_interval": {"type": "integer", "minimum": 1},
        "stop_on_error": {"type": "boolean"},
        "rerun_errors": {"type": "boolean"},
        "include_tags": {"type": "array", "items": {"type": "string"}},
        "exclude_tags": {"type": "array", "items": {"type": "string"}},
        "case_ids": {"type": "array", "items": {"type": "string"}},
        "redact_env": {"type": "array", "items": {"type": "string"}},
        "checkpoint_hmac_env": {"type": ["string", "null"]},
        "max_evidence_bytes": {"type": "integer", "minimum": 1000000, "maximum": 64000000}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {"type": "string"},
        "checkpoint_file": {"type": "string"},
        "formats": {"type": "array", "items": {"enum": ["json", "jsonl", "markdown", "html", "junit", "sarif"]}},
        "fail_on_findings": {"type": "boolean"}
      }
    }
  }
}
