{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:advent-prompt-pwn:schema:reproducers:v1",
  "title": "advent-prompt-pwn minimal reproducers v1",
  "type": "object",
  "required": ["schema_version", "source_run_id", "source_report_sha256", "reproducers"],
  "properties": {
    "schema_version": {"const": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reproducers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "case_id",
          "variant_id",
          "strategy",
          "messages",
          "message_count",
          "character_count",
          "evidence_sha256",
          "oracle_reason"
        ],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "minLength": 1},
          "variant_id": {"type": "string", "minLength": 1},
          "strategy": {"type": "string", "minLength": 1},
          "messages": {"type": "array", "minItems": 1},
          "message_count": {"type": "integer", "minimum": 1},
          "character_count": {"type": "integer", "minimum": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "oracle_reason": {"type": "string"}
        }
      }
    }
  }
}
